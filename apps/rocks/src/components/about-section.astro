---
// Wires the avatar through the shared DuotonePanel (which uses astro:assets'
// <Image> internally — never ImageMetadata.src, repo gotcha) and slots it into
// the shared React AboutSection. Both index pages render this once, so the
// image wiring lives in exactly one place. The duotone wrapper sits inside the
// section's torn clip (see about-section.tsx's TornPrint).
import portrait from '../assets/avatar.png';
import DuotonePanel from './duotone-panel.astro';
import { AboutSection } from './about-section';
import type { Strings } from '../i18n/types';

interface Props {
  about: Strings['about'];
}

const { about } = Astro.props;
---

<AboutSection about={about}>
  {/* Below the fold: lazy, no fetchpriority boost (contrast with the hero art). */}
  <DuotonePanel
    slot="avatar"
    src={portrait}
    alt={about.avatarAlt}
    widths={[160, 320]}
    sizes="160px"
    class="aspect-square h-full w-full"
  />
</AboutSection>
