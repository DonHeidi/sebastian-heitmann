---
/**
 * The classic device reel for a case detail page (task 28): laptop centred and
 * largest, tablet overlapping in front on the left, phone in front on the
 * right. Renders whichever subset of `showcase` the entry actually supplies —
 * a single device simply stands centred and a little larger.
 *
 * Layout is a bottom-aligned flex row with negative margins for the overlap
 * (no absolute positioning, no aspect-ratio scaffold): that way ANY subset
 * composes itself, and because each frame is an aspect-ratio box the section
 * reserves its full height before the screenshots load — no layout shift.
 * Depth ordering is z-index, not DOM order, so the reading order stays
 * laptop → tablet → phone.
 *
 * Below `md` the row becomes a column: the laptop full width, then the tablet
 * and phone side by side underneath. The inner wrapper that pairs them turns
 * into `display: contents` at `md`, which dissolves it so all three frames
 * become siblings of the same row — the `order-*` utilities then place the
 * tablet to the left of the laptop without any DOM duplication.
 *
 * Poses are static rotates in the site's 3D poster language (`case-card.tsx`):
 * positive `rotateY` brings the LEFT edge forward, so a device standing left
 * of centre turns to face the viewer with a positive angle and one standing
 * right with a negative one; `rotateX` is always positive (top leaning back),
 * matching the case tiles. Nothing animates and nothing hydrates.
 */
import type { ImageMetadata } from 'astro';
import type { Strings } from '../i18n/types';
import DeviceFrame from './device-frame.astro';

export interface ShowcaseImages {
  desktop?: ImageMetadata;
  tablet?: ImageMetadata;
  phone?: ImageMetadata;
}

interface Props {
  showcase: ShowcaseImages;
  strings: Strings['showcase'];
  class?: string;
}

const { showcase, strings, class: className = '' } = Astro.props;
const { desktop, tablet, phone } = showcase;
const solo = [desktop, tablet, phone].filter(Boolean).length === 1;

/* Layout boxes. Full literals per branch (Tailwind scans source text, so a
 * class can never be assembled from fragments). Percentages are of the
 * 52.5rem prose column: the trio spans 70 + 25 + 13 − 6 − 6 = 96% of it, which
 * keeps the reel visually inset from the copy above and below it.
 * Overlaps only apply where there is actually something to overlap.
 *
 * A laptop's box is its DECK's width, i.e. the whole machine (see the block
 * derivation in `device-frame.astro`); its lid is 81.5% of that. So these
 * numbers are the real footprint and nothing overhangs the column — which is
 * also why `w-full` is safe on mobile. */
const desktopBox = solo
  ? 'w-full md:order-2 md:w-[82%]'
  : 'w-full md:order-2 md:w-[70%]';
const tabletBox = solo
  ? 'w-[62%] md:order-1 md:w-[34%]'
  : desktop
    ? 'w-[46%] md:order-1 md:w-[25%] md:-mr-[6%]'
    : 'w-[46%] md:order-1 md:w-[30%]';
const phoneBox = solo
  ? 'w-[34%] md:order-3 md:w-[22%]'
  : desktop
    ? 'w-[24%] md:order-3 md:w-[13%] md:-ml-[6%]'
    : 'w-[24%] md:order-3 md:w-[17%] md:-ml-[4%]';

/* A device standing alone is the whole picture, so it gets a slightly stronger
 * single turn — EXCEPT the laptop, which keeps essentially the frontal pose in
 * both branches. A laptop is read by its silhouette (wide deck, narrower lid);
 * a `rotateY` big enough to be felt shears that outline into a trapezoid and
 * hands back the ambiguity the proportions just resolved. Product photography
 * shoots laptops near-front-on for the same reason, and turns phones and
 * tablets freely because a rectangle stays a rectangle. `rotateX` stays
 * positive on all three (top leaning back), matching the case tiles: on the
 * laptop it is also what puts the eye slightly above the deck, which is the
 * viewpoint the wide deck implies. */
const SOLO_POSE = 'rotate-x-3 rotate-y-7';
const desktopPose = 'rotate-x-2 rotate-y-1';
const tabletPose = solo ? SOLO_POSE : 'rotate-x-3 rotate-y-12';
const phonePose = solo ? SOLO_POSE : 'rotate-x-4 -rotate-y-14';

/* `sizes` for the widest case each frame can reach — its SOLO width — so a
 * screenshot is never under-resolved whichever branch above applies. The
 * column is `100vw − 3rem` below `md`; above it, 52.5rem, which the fluid root
 * (task 27) grows to ~997px at 2560, hence the px figures: 82% / 34% / 22%
 * of that. The laptop carries an extra 0.796 factor because its image fills
 * the lid's screen (0.9765 × 81.5%), not the box. */
const DESKTOP_SIZES = '(max-width: 767px) calc((100vw - 3rem) * 0.8), 650px';
const TABLET_SIZES = '(max-width: 767px) calc((100vw - 3rem) * 0.62), 340px';
const PHONE_SIZES = '(max-width: 767px) calc((100vw - 3rem) * 0.34), 220px';
---

<div
  class={`flex flex-col items-center gap-10 md:flex-row md:items-end md:justify-center md:gap-0 ${className}`}
>
  {desktop && (
    <DeviceFrame
      kind="desktop"
      src={desktop}
      alt={strings.desktopAlt}
      class={desktopBox}
      pose={desktopPose}
      sizes={DESKTOP_SIZES}
    />
  )}
  {(tablet || phone) && (
    <div class="flex w-full items-end justify-center gap-6 md:contents">
      {tablet && (
        <DeviceFrame
          kind="tablet"
          src={tablet}
          alt={strings.tabletAlt}
          class={`relative z-10 ${tabletBox}`}
          pose={tabletPose}
          sizes={TABLET_SIZES}
        />
      )}
      {phone && (
        <DeviceFrame
          kind="phone"
          src={phone}
          alt={strings.phoneAlt}
          class={`relative z-20 ${phoneBox}`}
          pose={phonePose}
          sizes={PHONE_SIZES}
        />
      )}
    </div>
  )}
</div>
