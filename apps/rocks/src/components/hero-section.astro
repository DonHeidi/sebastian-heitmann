---
// Wires the hero artwork through the shared DuotonePanel (which uses
// astro:assets' <Image> internally — never ImageMetadata.src, repo gotcha)
// and slots it into the shared React Hero. Both index pages render this once,
// so the image wiring lives in exactly one place. The masthead names are brand
// literals (the site owner's name), not locale copy, so they are passed here
// rather than through i18n.
import { Image } from 'astro:assets';
import artwork from '../assets/guitar-player.png';
import artworkLight from '../assets/guitar-player-light.png';
import DuotonePanel from './duotone-panel.astro';
import { Hero } from './hero';
import type { Strings } from '../i18n/types';

interface Props {
  hero: Strings['hero'];
  credits: Strings['credits'];
}

const { hero, credits } = Astro.props;

// Both artworks share the same 1024×1536 frame and near-identical composition
// (helmet top-center, keyboard-guitar diagonal), so the lg+ crop — derived for
// the dark artwork in task 10 — is shared. Below lg the two themes want
// DIFFERENT verticals (task 17): both scale(1.4) from a negative
// transform-origin (see the layer comment below), but the dark crop's
// `50% -85%` pushes the figure far down past the text block, which on the
// light art opened a dead cream band between the tagline and the figure (the
// dark art fills that zone with red glow; the light art's ground there is
// empty near-white). `50% -55%` lifts the light figure so the visor tucks
// just under the tagline rule — the same composition the desktop poster has.
const cropClass =
  'object-[50%_14%] max-lg:scale-140 max-lg:object-[50%_8%] max-lg:[transform-origin:50%_-85%]';
const cropClassLight =
  'object-[50%_14%] max-lg:scale-140 max-lg:object-[50%_8%] max-lg:[transform-origin:50%_-55%]';
---

<Hero hero={hero} credits={credits} nameFirst="Sebastian" nameLast="Heitmann">
  {/* The artwork is the likely LCP: eager + high priority (via `eager`). It is
      the full-bleed poster background: the panel fills the hero block, and the
      1024×1536 portrait source is cropped via object-position. The masthead
      lockup now anchors the top of the poster (owner directive), so the crop
      is pulled down from the old top-third bias (50% 22%) to `50% 14%` on
      lg+ screens, keeping the whole helmet out from under the text band — the
      visor sits just below the tagline rule, with the keyboard-guitar neck
      below it.

      Below `lg` the container flips from landscape-ish to portrait-tall (the
      hero's viewport-filling height, task 18, against a narrow width), which
      makes `object-fit: cover`'s crop window cover most of the source height —
      object-position alone can no longer pull the helmet out from behind the
      (now two-line, taller) masthead, since panning can't zoom. `max-lg:` adds
      a `scale(1.4)` with a negative `transform-origin` (above the box, in
      the pre-scale crop's coordinate space) to zoom into the helmet and push
      it down past the text block instead of just panning to it — the negative
      origin was hand-derived (see task-10-report.md) then verified visually
      per breakpoint, not a value you can eyeball.

      Astro clamps generated widths at the 1024px source (it never upscales),
      so the 1440/1920 entries are dropped today and the browser upscales the
      1024w candidate on large screens instead — softness the owner accepted,
      and the duotone treatment hides most of it. The entries stay listed so a
      larger source master would light them up without a code change. */}
  <DuotonePanel
    slot="art"
    src={artwork}
    alt={hero.artAlt}
    widths={[480, 768, 1080, 1440, 1920]}
    sizes="100vw"
    eager
    class="absolute inset-0 hidden dark:block"
    imgClass={cropClass}
  />
  {/* Light-theme counterpart (owner-supplied): white/orange on near-white, i.e.
      already palette-native — it skips the duotone pipeline (duotoning would
      map its near-white background to solid accent and turn the whole light
      poster orange). It is NOT raw either (task 17): raw, its cool near-white
      ground read as a discrete grey panel over the cream page — hard seam
      where the mobile-scaled image's top edge landed, wrinkle texture blocked.
      Instead it mirrors the duotone panel's own construction: a paper-colored
      underlay (`bg-[var(--v8-bg)]`, also covering the band above the scaled
      image's top edge below lg) with the image `multiply`ed over it inside an
      `isolate` wrapper, so the ground sinks into the paper and the z-20
      wrinkle overlay reads THROUGH the art — one continuous sheet. The filter
      lifts the ground to true white so multiply renders it as bare paper
      (brightness/contrast) and keeps the flames punchy under the blend
      (saturate). Consequence (documented call): the hover color-reveal only
      exists where duotone does, so the light hero has no reveal state.
      Loading: the dark artwork stays the eager/high-priority LCP (the
      poster's primary art direction); this one is lazy. `display: none` + lazy
      means dark-theme visitors never fetch it, while light-theme visitors get
      it promptly (it's in-viewport at the top of the page) at the cost of a
      slightly later art paint plus the unused eager dark download — the
      accepted tradeoff over double-eager-loading both for everyone. */}
  <div slot="art" class="absolute inset-0 isolate bg-[var(--v8-bg)] dark:hidden">
    <Image
      src={artworkLight}
      alt={hero.artAlt}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      class={`h-full w-full object-cover mix-blend-multiply brightness-[1.06] contrast-[1.05] saturate-[1.1] ${cropClassLight}`}
    />
  </div>
</Hero>
