---
import '../styles/global.css';
import { localeConfig } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

type Props = {
  locale: Locale;
  title: string;
  description: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  includeRedirectScript?: boolean;
  ogType?: string;
  canonical?: string;
};

const {
  locale,
  title,
  description,
  alternates = [],
  includeRedirectScript = false,
  ogType = 'website',
  canonical,
} = Astro.props;
const htmlLang = localeConfig[locale].htmlLang;
const siteOrigin = 'https://www.sebastian-heitmann.rocks';
const canonicalUrl = canonical ?? `${siteOrigin}${Astro.url.pathname}`;
---

<html lang={htmlLang}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="apple-touch-icon" href="/favicon.svg">
        <meta name="theme-color" content="#0C0C0C">
        <title>{title}</title>
        <meta name="description" content={description}>
        <link rel="canonical" href={canonicalUrl}>
        <meta property="og:type" content={ogType}>
        <meta property="og:title" content={title}>
        <meta property="og:description" content={description}>
        <meta property="og:url" content={canonicalUrl}>
        <meta property="og:locale" content={locale === 'de-de' ? 'de_DE' : 'en_US'}>
        <meta property="og:locale:alternate" content={locale === 'de-de' ? 'en_US' : 'de_DE'}>
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={description}>
        <link rel="preload" href="/fonts/DMSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/Anton-Regular.woff2" as="font" type="font/woff2" crossorigin>
        {alternates.map(alt => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Sebastian Heitmann",
            "jobTitle": "Technology Consultant",
            "description": description,
            "url": "https://www.sebastian-heitmann.rocks",
            "sameAs": [
                "https://www.sebastian-heitmann.dev",
                "https://www.linkedin.com/in/sebastian-heitmann/",
                "https://github.com/DonHeidi"
            ],
            "knowsLanguage": ["de", "en"]
        })} />
        <script is:inline>
            (function() {
                var stored = localStorage.getItem('theme');
                if (stored === 'dark' || stored === 'light') {
                    document.documentElement.classList.add(stored);
                } else {
                    document.documentElement.classList.add(
                        window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
                    );
                }
            })();
        </script>
        <slot name="head" />
        {includeRedirectScript && (
            <script is:inline>
                (function() {
                    if (localStorage.getItem('locale')) return;
                    var lang = (navigator.language || '').toLowerCase();
                    var target;
                    if (lang.startsWith('de')) target = 'de-de';
                    if (target) {
                        localStorage.setItem('locale', target);
                        window.location.replace('/' + target + '/');
                    } else {
                        localStorage.setItem('locale', 'en-us');
                    }
                })();
            </script>
        )}
    </head>
    <body>
        <slot />
    </body>
</html>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
</script>

<script>
    // Magnet physics for `.v8-magnet` controls (see the class in global.css
    // for the design rationale). The script only WRITES custom properties and
    // state classes; all rendering lives in CSS, so this stays a few dumb
    // event handlers with no per-frame work of its own — the browser's
    // transition engine does the smoothing.
    document.addEventListener('DOMContentLoaded', () => {
        // Tilt is pointer-driven, so it only exists for fine pointers that
        // hover; the press/snap states are gated with it — on touch, the
        // native active states are enough and a spring would fire on scroll
        // taps. Reduced motion turns the whole behavior off (CSS also
        // neutralizes the transforms as a second line of defense).
        const enabled = window.matchMedia('(hover: hover) and (pointer: fine)');
        const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');
        // Degrees at the very edge of the face. Raised from 6 when the slab
        // got its painted thickness — a visibly thick object can turn a
        // little further before it reads as flapping, and the shorter
        // perspective (see .v8-magnet) needs the extra angle to show.
        // Large magnets (the ticket sheets) override per element via
        // data-magnet-tilt: at their size, button-scale angles read as the
        // whole card lunging.
        const MAX_TILT = 8;

        // Grip spin (owner: "if you click and haven't released you can
        // slightly drag ... spin it, depending on the position"): while
        // pressed ON the face, the response strengthens — tilt and lean
        // follow the finger harder, twisting the object against its spring.
        // CONTACT ENDS AT THE FACE'S EDGE (owner: leaving the item mid-drag
        // must not keep it tilted): sliding off releases everything — the
        // magnet springs home — but the grip stays armed via pointer
        // capture, so sliding back on re-engages without re-pressing.
        const PRESS_GAIN = 1.8;
        // A release after real dragging must not navigate — the user was
        // spinning the object, not clicking it.
        const CLICK_SLOP_PX = 10;

        document.querySelectorAll<HTMLElement>('.v8-magnet').forEach((el) => {
            const maxTilt = Number(el.dataset.magnetTilt) || MAX_TILT;
            let downAt: { x: number; y: number } | null = null;
            let dragged = false;

            el.addEventListener('pointermove', (ev) => {
                if (!motionOk.matches) return;
                // GRIP is the pointer being held since a pointerdown (downAt),
                // independent of the weigh-down class below. Hover-tracking
                // needs a fine pointer; a gripped magnet responds on any
                // pointer — that's how touch gets to play (press, then
                // wiggle; touch-action lets vertical swipes scroll instead).
                const gripped = downAt !== null;
                if (!enabled.matches && !gripped) return;
                // Re-engaging cancels a running spring return: following the
                // cursor goes back to the fast easing, picking up from
                // wherever the swing currently is.
                el.classList.remove('v8-magnet-return');
                if (downAt && Math.hypot(ev.clientX - downAt.x, ev.clientY - downAt.y) > CLICK_SLOP_PX) {
                    dragged = true;
                }
                const r = el.getBoundingClientRect();
                const rawX = (ev.clientX - r.left) / r.width;
                const rawY = (ev.clientY - r.top) / r.height;
                // Contact model while gripped: the finger only acts on the
                // magnet while it is OVER the face. Sliding off releases the
                // weigh-down AND the tilt/lean — full spring home (owner:
                // off-face must not stay tilted toward the mouse) — while the
                // grip stays armed for re-engagement on the way back in.
                if (gripped) {
                    const onFace = rawX >= 0 && rawX <= 1 && rawY >= 0 && rawY <= 1;
                    el.classList.toggle('v8-magnet-pressed', onFace);
                    if (!onFace) {
                        if (motionOk.matches) el.classList.add('v8-magnet-return');
                        el.style.removeProperty('--v8-magnet-rx');
                        el.style.removeProperty('--v8-magnet-ry');
                        el.style.removeProperty('--v8-magnet-tx');
                        el.style.removeProperty('--v8-magnet-ty');
                        el.style.removeProperty('--v8-magnet-x');
                        el.style.removeProperty('--v8-magnet-y');
                        return;
                    }
                }
                const gain = gripped ? PRESS_GAIN : 1;
                const relX = Math.min(1, Math.max(0, rawX));
                const relY = Math.min(1, Math.max(0, rawY));
                // Pressure model: the edge UNDER the cursor dips away from the
                // viewer. Cursor at the top presses the top edge down
                // (positive rotateX); cursor at the right presses the right
                // edge down (positive rotateY).
                el.style.setProperty('--v8-magnet-rx', `${((0.5 - relY) * 2 * maxTilt * gain).toFixed(2)}deg`);
                el.style.setProperty('--v8-magnet-ry', `${((relX - 0.5) * 2 * maxTilt * gain).toFixed(2)}deg`);
                // Attraction — GRIP-ONLY (owner: "I don't want a position
                // shift on simple hover"): while held, the whole magnet
                // leans toward the pointer, scaled to the element (a button
                // shifts ~7px, a ticket ~20px at full reach) — dragging it
                // around is the "wiggle it around" feel. Plain hover keeps
                // position and only tilts; the explicit clear below also
                // resets the lean the moment a grip ends under a still-
                // hovering cursor.
                if (gripped) {
                    const pull = Math.min(12, Math.max(3, Math.min(r.width, r.height) * 0.08));
                    el.style.setProperty('--v8-magnet-tx', `${((relX - 0.5) * 2 * pull * gain).toFixed(1)}px`);
                    el.style.setProperty('--v8-magnet-ty', `${((relY - 0.5) * 2 * pull * gain).toFixed(1)}px`);
                } else {
                    el.style.removeProperty('--v8-magnet-tx');
                    el.style.removeProperty('--v8-magnet-ty');
                }
                // The metal face's specular hotspot tracks the same position —
                // the reflection sliding against the tilt is what sells the
                // object as metal (see .v8-metal).
                el.style.setProperty('--v8-magnet-x', `${(relX * 100).toFixed(1)}%`);
                el.style.setProperty('--v8-magnet-y', `${(relY * 100).toFixed(1)}%`);
            });

            const release = () => {
                downAt = null;
                // Spring, don't snap: the return class swaps in the long
                // damped-oscillation easing BEFORE the tilt targets reset, so
                // the swing back to rest overshoots and settles (see
                // .v8-magnet-return in global.css). transitionend clears it.
                if (motionOk.matches) el.classList.add('v8-magnet-return');
                el.style.removeProperty('--v8-magnet-rx');
                el.style.removeProperty('--v8-magnet-ry');
                el.style.removeProperty('--v8-magnet-tx');
                el.style.removeProperty('--v8-magnet-ty');
                el.style.removeProperty('--v8-magnet-x');
                el.style.removeProperty('--v8-magnet-y');
                if (el.classList.contains('v8-magnet-pressed')) {
                    el.classList.remove('v8-magnet-pressed');
                    if (motionOk.matches) el.classList.add('v8-magnet-snap');
                }
            };

            el.addEventListener('pointerdown', (ev) => {
                // Gated on motion only, NOT on pointer fineness: pressing is
                // how touch grips the magnet (see the pointermove gate).
                if (!motionOk.matches) return;
                el.classList.remove('v8-magnet-snap');
                el.classList.add('v8-magnet-pressed');
                downAt = { x: ev.clientX, y: ev.clientY };
                dragged = false;
                // Capture keeps pointermove flowing while gripped, even past
                // the element's edges — off-face the magnet rests (see the
                // contact model in pointermove), but the stream is what lets
                // sliding back onto the face re-engage the grip.
                el.setPointerCapture(ev.pointerId);
            });
            el.addEventListener('pointerup', (ev) => {
                el.releasePointerCapture(ev.pointerId);
                downAt = null;
                // The grip's position lean springs home FROM THE RELEASE
                // MOMENT, under the return easing — leaving it for the next
                // pointermove made it jump back on the fast follow timing,
                // which read as a snap (most visibly on the tickets, where
                // the lean is largest).
                if (motionOk.matches) el.classList.add('v8-magnet-return');
                el.style.removeProperty('--v8-magnet-tx');
                el.style.removeProperty('--v8-magnet-ty');
                // Un-gripping rescales the tilt: without this the magnet
                // holds its 1.8x grip angles until the next pointermove. A
                // mouse relaxes to the hover response at the release point; a
                // lifted finger leaves nothing hovering, so touch springs
                // fully home.
                if (enabled.matches) {
                    const r = el.getBoundingClientRect();
                    const relX = Math.min(1, Math.max(0, (ev.clientX - r.left) / r.width));
                    const relY = Math.min(1, Math.max(0, (ev.clientY - r.top) / r.height));
                    el.style.setProperty('--v8-magnet-rx', `${((0.5 - relY) * 2 * maxTilt).toFixed(2)}deg`);
                    el.style.setProperty('--v8-magnet-ry', `${((relX - 0.5) * 2 * maxTilt).toFixed(2)}deg`);
                } else {
                    el.style.removeProperty('--v8-magnet-rx');
                    el.style.removeProperty('--v8-magnet-ry');
                    el.style.removeProperty('--v8-magnet-x');
                    el.style.removeProperty('--v8-magnet-y');
                }
                if (!el.classList.contains('v8-magnet-pressed')) return;
                el.classList.remove('v8-magnet-pressed');
                if (motionOk.matches) el.classList.add('v8-magnet-snap');
            });
            // A spin is not a click: releasing after real movement must not
            // follow the link the magnet happens to be.
            el.addEventListener('click', (ev) => {
                if (dragged) {
                    ev.preventDefault();
                    dragged = false;
                }
            });
            // Anchors are natively draggable; a gripped move would start an
            // HTML5 drag, whose pointercancel would rip the magnet out of the
            // grip. The magnet IS the drag interaction here.
            el.addEventListener('dragstart', (ev) => ev.preventDefault());
            // Leaving releases the magnet — UNLESS it is gripped: pointer
            // capture still fires boundary events when the pointer crosses
            // the element's edge, and crossing that edge mid-grip is exactly
            // the spin, not a release. (The post-pointerup leave, with the
            // grip already cleared, then springs it home as usual.)
            el.addEventListener('pointerleave', () => {
                if (downAt) return;
                release();
            });
            el.addEventListener('pointercancel', release);
            el.addEventListener('animationend', () => el.classList.remove('v8-magnet-snap'));
            el.addEventListener('transitionend', (ev) => {
                if (ev.propertyName === 'transform') el.classList.remove('v8-magnet-return');
            });
        });
    });
</script>

<script>
    // Touch flip for the jewel cases (see case-card.tsx's interaction
    // contract). Touch has no hover, and the owner wants a tap to ROTATE the
    // case — never navigate — with the back face's link row as the only way
    // through. One delegated listener: a tap outside a flipped card flips it
    // back, a tap on a card toggles it, and a tap that lands on a real link
    // (the back row's anchor) is left alone so navigation just works.
    document.addEventListener('DOMContentLoaded', () => {
        if (!window.matchMedia('(hover: none)').matches) return;
        const cards = Array.from(document.querySelectorAll('.v8-jewel-card'));
        if (cards.length === 0) return;
        document.addEventListener('click', (ev) => {
            const target = ev.target instanceof Element ? ev.target : null;
            const card = target?.closest('.v8-jewel-card') ?? null;
            cards.forEach((other) => {
                if (other !== card) other.classList.remove('is-flipped');
            });
            if (!card || target?.closest('a')) return;
            card.classList.toggle('is-flipped');
        });
    });
</script>
