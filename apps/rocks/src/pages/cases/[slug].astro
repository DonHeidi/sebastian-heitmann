---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import { getStrings, getHreflangAlternates } from '../../i18n/utils';
import { Navigation } from '../../components/navigation';
import { Footer } from '../../components/footer';
import { ThemeToggle } from '../../components/theme-toggle';
import DuotonePanel from '../../components/duotone-panel.astro';
import DeviceShowcase from '../../components/device-showcase.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases');
  return entries
    .filter((e) => e.id.startsWith('en-us/') && e.data.kind === 'case-study' && !e.data.draft)
    .map((entry) => ({
      params: { slug: entry.id.split('/').slice(1).join('/') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const locale = 'en-us';
const t = getStrings(locale);
const slug = entry.id.split('/').slice(1).join('/');
const { Content } = await render(entry);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const period = `${formatDate(entry.data.startDate)} — ${entry.data.endDate ? formatDate(entry.data.endDate) : t.cases.ongoing}`;
/* The device reel renders only for entries that actually ship screenshots.
 * Collapsing an empty `showcase` group to `undefined` here means the section
 * has exactly one condition to test, and a page without screenshots emits
 * byte-identical markup to before the reel existed. */
const showcase =
  entry.data.showcase?.desktop || entry.data.showcase?.tablet || entry.data.showcase?.phone
    ? entry.data.showcase
    : undefined;
---

<Layout
  locale={locale}
  title={`${entry.data.title} — ${t.meta.title}`}
  description={entry.data.summary}
  alternates={getHreflangAlternates(`/cases/${slug}/`)}
  ogType="article"
>
  <Navigation nav={t.nav} languagePicker={t.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
    <ThemeToggle client:load labels={t.themeToggle} />
  </Navigation>
  <main class="relative mx-auto max-w-[52.5rem] px-6 py-12 md:py-20">
    <a href={getRelativeLocaleUrl(locale, '/')} class="font-mono text-[0.625rem] tracking-[0.1em] text-muted-foreground uppercase no-underline transition-colors hover:text-foreground">
      ← {t.cases.backToOverview}
    </a>
    <h1 class="mt-6 font-[family-name:var(--v8-font-poster)] text-4xl tracking-[0.02em] text-foreground uppercase md:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground">{entry.data.summary}</p>
    <span class="mt-8 inline-block rotate-2 border border-border px-2 py-1 font-mono text-[0.5625rem] tracking-[0.14em] text-muted-foreground uppercase">
      {t.cases.stampCaseStudy} {entry.data.startDate.getUTCFullYear()}
    </span>
    <dl class="mt-3 grid gap-2 border border-border bg-surface p-5 md:grid-cols-3">
      <div>
        <dt class="font-mono text-[0.625rem] tracking-[0.1em] text-muted-foreground uppercase">{t.cases.roleLabel}</dt>
        <dd class="mt-1 text-sm text-foreground">{entry.data.role}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.625rem] tracking-[0.1em] text-muted-foreground uppercase">{t.cases.periodLabel}</dt>
        <dd class="mt-1 text-sm text-foreground">{period}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.625rem] tracking-[0.1em] text-muted-foreground uppercase">{t.cases.stackLabel}</dt>
        <dd class="mt-1 text-sm text-foreground">{entry.data.stack.join(' · ')}</dd>
      </div>
    </dl>
    {entry.data.cover && (
      <DuotonePanel
        src={entry.data.cover}
        alt=""
        widths={[768, 1440]}
        sizes="(max-width: 840px) 100vw, 840px"
        class="mt-10 aspect-[16/9] w-full border border-border"
      />
    )}
    {showcase && (
      <section class="mt-12" aria-labelledby="showcase-heading">
        <h2
          id="showcase-heading"
          class="font-mono text-[0.625rem] tracking-[0.1em] text-muted-foreground uppercase"
        >
          {t.showcase.kicker}
        </h2>
        <DeviceShowcase showcase={showcase} strings={t.showcase} class="mt-7" />
      </section>
    )}
    <article class="case-prose mt-10">
      <Content />
    </article>
    {entry.data.links.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-3">
        {entry.data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="border border-border px-4 py-2 font-mono text-[0.625rem] tracking-[0.1em] text-foreground uppercase no-underline transition-colors hover:border-primary hover:text-primary">
            {link.label} ↗
          </a>
        ))}
      </div>
    )}
  </main>
  <Footer footer={t.footer} />
</Layout>
