---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import { getStrings, getHreflangAlternates } from '../../i18n/utils';
import { Navigation } from '../../components/navigation';
import { Footer } from '../../components/footer';
import { ThemeToggle } from '../../components/theme-toggle';
import HeroSection from '../../components/hero-section.astro';
import AboutSection from '../../components/about-section.astro';
import { CaseCard } from '../../components/case-card';
import { TeaserCard } from '../../components/teaser-card';
import { SectionHeader } from '../../components/section-header';
import DuotonePanel from '../../components/duotone-panel.astro';
import { blogTeasers } from '../../data/blog-teasers';
import { chunkRows } from '../../lib/rows';

const locale = 'de-de';
const t = getStrings(locale);

const entries = (await getCollection('cases'))
  .filter((e) => e.id.startsWith(`${locale}/`) && !e.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.startDate.valueOf() - a.data.startDate.valueOf());
const caseStudies = entries.filter((e) => e.data.kind === 'case-study');
const projects = entries.filter((e) => e.data.kind === 'project');
const caseHref = (e: (typeof entries)[number]) =>
  getRelativeLocaleUrl(locale, `/cases/${e.id.split('/').slice(1).join('/')}`);

/* Balanced centered rows — mirror of en-us (see src/pages/index.astro and
   lib/rows.ts for the layout rationale). */
const caseRows = chunkRows(caseStudies.map((e, i) => ({ e, i })));
const projectRows = chunkRows(projects.map((e, i) => ({ e, i })));
const teaserRows = chunkRows(blogTeasers[locale].map((teaser, i) => ({ teaser, i })));
const tileW = 'w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.3334rem)]';
---

<Layout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  alternates={getHreflangAlternates('/')}
>
  {/* `min-h-svh flex flex-col` (task 18): the nav's height is measured by
      layout, not assumed — it can wrap to 2 or 3 rows on narrow widths (de-de's
      longer CTA wraps to 3 at 375), so the hero (a `flex-1` child, see hero.tsx)
      fills exactly the remaining first-viewport space below the nav at every
      width instead of subtracting a fixed desktop-nav rem value. */}
  <div class="flex min-h-svh flex-col">
    <Navigation nav={t.nav} languagePicker={t.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
      <ThemeToggle client:load labels={t.themeToggle} />
    </Navigation>
    <HeroSection hero={t.hero} credits={t.credits} />
  </div>
  <main>
    <section class="mx-auto max-w-[90rem] px-6 py-12 md:px-20" id="cases">
      <SectionHeader title={t.cases.sectionTitle} />
      <div class="mt-8 flex flex-col gap-8">
        {caseRows.map((row) => (
          <div class="flex flex-wrap justify-center gap-8">
            {row.map(({ e, i }) => (
              <div class={tileW}>
                <CaseCard
                  data={e.data}
                  href={caseHref(e)}
                  strings={t.cases}
                  backStrings={t.caseBack}
                  index={i}
                  hasCover={Boolean(e.data.cover)}
                >
                  {e.data.cover && (
                    <DuotonePanel
                      slot="coverPanel"
                      src={e.data.cover}
                      alt=""
                      widths={[480, 768, 960]}
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      class="h-full w-full"
                    />
                  )}
                  {e.data.cover && (
                    <DuotonePanel
                      slot="backPanel"
                      duotone={false}
                      src={e.data.cover}
                      alt=""
                      widths={[480, 768, 960]}
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      class="h-full w-full"
                    />
                  )}
                </CaseCard>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
    {projects.length > 0 && (
      <section class="mx-auto max-w-[90rem] px-6 py-12 md:px-20" id="projects">
        <SectionHeader title={t.projects.sectionTitle} />
        <div class="mt-8 flex flex-col gap-8">
          {projectRows.map((row) => (
            <div class="flex flex-wrap justify-center gap-8">
              {row.map(({ e, i }) => (
                <div class={tileW}>
                  <CaseCard
                    data={e.data}
                    href={caseHref(e)}
                    strings={t.cases}
                    backStrings={t.caseBack}
                    index={i}
                    poseOffset={caseStudies.length}
                    hasCover={Boolean(e.data.cover)}
                  >
                    {e.data.cover && (
                      <DuotonePanel
                        slot="coverPanel"
                        src={e.data.cover}
                        alt=""
                        widths={[480, 768, 960]}
                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        class="h-full w-full"
                      />
                    )}
                    {e.data.cover && (
                      <DuotonePanel
                        slot="backPanel"
                        duotone={false}
                        src={e.data.cover}
                        alt=""
                        widths={[480, 768, 960]}
                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        class="h-full w-full"
                      />
                    )}
                  </CaseCard>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}
    <section class="mx-auto max-w-[90rem] px-6 py-12 md:px-20" id="writing">
      <SectionHeader title={t.teasers.sectionTitle} />
      <p class="reveal mt-3 max-w-[58ch] text-sm text-muted-foreground">{t.teasers.intro}</p>
      <div class="mt-8 flex flex-col gap-6">
        {teaserRows.map((row) => (
          <div class="flex flex-wrap justify-center gap-6">
            {row.map(({ teaser, i }) => (
              <div class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
                {/* The row's default align-stretch gives this wrapper the row's
                    height, and the card's own h-full fills it — equal-height
                    cards per row, same as the grid it replaces. */}
                <TeaserCard teaser={teaser} readOn={t.teasers.readOn} index={i} />
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
    <AboutSection about={t.about} />
  </main>
  <Footer footer={t.footer} />
</Layout>
