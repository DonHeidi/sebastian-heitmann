# Local build defaults for the website. No secrets — safe to commit.
# @defaultRequired=infer @defaultSensitive=false
# ----------

# Site URL (used for hreflang tags and canonical URLs)
# @type=url @required
PUBLIC_SITE_URL=https://www.sebastian-heitmann.dev

# Mail service endpoint (Scaleway serverless function URL).
# Public by definition — it ships in the HTML of every page that renders the
# contact form, so it is committed here rather than injected at build time. That
# keeps `bun run build` and `./scripts/deploy-website.sh` producing byte-identical
# output; previously only the deploy script supplied it, so a plain build shipped
# a contact form that rendered normally but failed on submit.
# Terraform remains the source of truth for the value: the deploy script compares
# `terraform output -raw function_endpoint` against this and aborts on a mismatch,
# so infra drift fails loudly instead of silently changing the artifact.
# @type=url @required
PUBLIC_MAIL_ENDPOINT=https://mailservicedymlu2fr-contact-handler.functions.fnc.nl-ams.scw.cloud
