---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Navigation } from '../../components/navigation';
import ThemeToggle from '@/components/theme-toggle.astro';
import { Footer } from '../../components/footer';
import { ArticleView } from '../../components/article-view';
import { getStrings, getHreflangAlternates } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { blogPosting, blogId } from '@sh/structured-data';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles', ({ data }) => !data.draft);
  const articles = allArticles.filter(({ id }) => !id.startsWith('de-de/'));
  const deSlugs = new Set(
    allArticles.filter(({ id }) => id.startsWith('de-de/')).map(({ id }) => id.replace('de-de/', ''))
  );
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, hasTranslation: deSlugs.has(entry.id) },
  }));
}

const { entry, hasTranslation } = Astro.props;
const { Content } = await render(entry);

const locale = (Astro.currentLocale ?? 'en-us') as Locale;
const s = getStrings(locale);

const authorEntry = await getEntry('authors', entry.data.author);
const publishedISO = entry.data.publishedAt.toISOString();
const modifiedISO = entry.data.updatedAt?.toISOString();

const dateLocale = locale === 'de-de' ? 'de-DE' : 'en-US';
const publishedDate = entry.data.publishedAt.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const wordCount = entry.body
  ? entry.body.replace(/```[\s\S]*?```/g, ' ').split(/\s+/).filter(Boolean).length
  : 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const currentSlug = entry.id.replace(/^de-de\//, '');

const authorAvatarSrc = authorEntry
  ? (await getImage({ src: authorEntry.data.avatar, width: 72, height: 72, format: 'webp' })).src
  : undefined;

const articleHeroImage = entry.data.headerImage
  ? await getImage({ src: entry.data.headerImage, width: 1200, height: 480, format: 'webp' })
  : undefined;

const articleDetailImage = entry.data.headerDetailImage
  ? await getImage({ src: entry.data.headerDetailImage, width: 200, height: 200, format: 'webp' })
  : undefined;

const siteOrigin = 'https://www.sebastian-heitmann.dev';
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
// The German URL for an untranslated slug serves this same English text and
// canonicalizes here — only declare the hreflang pair for real translations.
const alternates = hasTranslation ? getHreflangAlternates(`/articles/${currentSlug}`) : [];
const ogImage = entry.data.headerImage
  ? await getImage({
      src: entry.data.headerImage,
      width: 1200,
      height: 630,
      format: 'jpg',
      fit: 'cover',
    })
  : undefined;
const heroImageUrl = ogImage ? `${siteOrigin}${ogImage.src}` : undefined;

const structuredNodes = [
  blogPosting({
    url: canonicalUrl,
    headline: entry.data.title,
    description: entry.data.abstract,
    datePublished: publishedISO,
    dateModified: modifiedISO,
    image: heroImageUrl,
    keywords: entry.data.tags,
    locale,
    blogId: blogId('dev', locale),
  }),
];

let seriesParts: Array<{ slug: string; title: string; part: number }> = [];
if (entry.data.series) {
  const seriesName = entry.data.series.name;
  const allArticles = await getCollection('articles', ({ id, data }) =>
    !id.startsWith('de-de/') && !data.draft && data.series?.name === seriesName
  );
  seriesParts = allArticles
    .map((a) => ({ slug: a.id, title: a.data.title, part: a.data.series!.part }))
    .sort((a, b) => a.part - b.part);
}
---

<Layout
  locale={locale}
  title={`${entry.data.title} — Sebastian Heitmann`}
  description={entry.data.abstract ?? s.meta.description}
  ogType="article"
  ogImage={heroImageUrl}
  canonical={canonicalUrl}
  alternates={alternates}
  nodes={structuredNodes}
>
  <meta slot="head" property="article:published_time" content={publishedISO} />
  {modifiedISO && <meta slot="head" property="article:modified_time" content={modifiedISO} />}
  {authorEntry && <meta slot="head" property="article:author" content={authorEntry.data.name} />}
  <meta slot="head" property="article:section" content={s.categories[entry.data.category]} />
  {entry.data.tags?.map((tag) => (
    <meta slot="head" property="article:tag" content={tag} />
  ))}
  <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
    <ThemeToggle labels={s.nav.themeToggle} />
  </Navigation>
  <ArticleView
    strings={s.article}
    locale={locale}
    categoryLabel={s.categories[entry.data.category]}
    title={entry.data.title}
    subline={entry.data.subline}
    series={entry.data.series}
    seriesParts={seriesParts}
    currentSlug={currentSlug}
    publishedDate={publishedDate}
    publishedISO={publishedISO}
    readingMinutes={readingMinutes}
    heroImage={articleHeroImage ? { src: articleHeroImage.src, width: 1200, height: 480 } : undefined}
    detailImage={articleDetailImage ? { src: articleDetailImage.src, width: 200, height: 200 } : undefined}
    authorship={entry.data.authorship}
    aiTranslated={entry.data.aiTranslated}
    author={
      authorEntry
        ? {
            name: authorEntry.data.name,
            role: authorEntry.data.role,
            description: authorEntry.data.description,
            avatarSrc: authorAvatarSrc!,
            email: authorEntry.data.email,
            socials: authorEntry.data.socials,
          }
        : undefined
    }
    tags={entry.data.tags}
    backToAllHref={getRelativeLocaleUrl(locale, 'articles')}
  >
    <Content />
  </ArticleView>
  <Footer footer={s.footer} privacyHref={getRelativeLocaleUrl(locale, 'privacy')} imprintHref={getRelativeLocaleUrl(locale, 'imprint')} />
</Layout>
