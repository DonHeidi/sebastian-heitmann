---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Navigation } from '../components/navigation';
import { ThemeToggle } from '../components/theme-toggle';
import { CvSection } from '../components/cv/cv-section';
import { Footer } from '../components/footer';
import { getStrings, getHreflangAlternates } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import '../styles/cv-print.css';

const locale = Astro.currentLocale as Locale;
const s = getStrings(locale);
const alternates = getHreflangAlternates('/cv');
---
<Layout locale={locale} title={s.cv.meta.title} description={s.cv.meta.description} alternates={alternates}>
    <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
        <ThemeToggle client:load labels={s.nav.themeToggle} />
    </Navigation>
    <main>
        <CvSection cv={s.cv} />
    </main>
    <Footer footer={s.footer} privacyHref={getRelativeLocaleUrl(locale, 'privacy')} imprintHref={getRelativeLocaleUrl(locale, 'imprint')} />
</Layout>

<script>
    // CvSection is static TSX (not hydrated), so the download button's
    // handler is wired here — mirrors the old .astro's native onclick.
    document.querySelector('.cv-download')?.addEventListener('click', () => window.print());
</script>
