---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Navigation } from '../components/navigation';
import ThemeToggle from '@/components/theme-toggle.astro';
import { CvSection } from '../components/cv/cv-section';
import { Footer } from '../components/footer';
import { getStrings, getHreflangAlternates } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import '../styles/cv-print.css';
import { profileMainEntity, personOccupations } from '@sh/structured-data';
import { absoluteUrl } from '../i18n/utils';

const locale = Astro.currentLocale as Locale;
const s = getStrings(locale);
const alternates = getHreflangAlternates('/cv');

const cvUrl = absoluteUrl('/cv');
const structuredNodes = [
    profileMainEntity(cvUrl),
    personOccupations(s.cv.experience.map((e) => ({ role: e.role }))),
];
---
<Layout locale={locale} title={s.cv.meta.title} description={s.cv.meta.description} alternates={alternates} pageType="ProfilePage" breadcrumbLabel={s.nav.cvLabel} nodes={structuredNodes}>
    <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
        <ThemeToggle labels={s.nav.themeToggle} />
    </Navigation>
    <main>
        <CvSection cv={s.cv} />
    </main>
    <Footer footer={s.footer} privacyHref={getRelativeLocaleUrl(locale, 'privacy')} imprintHref={getRelativeLocaleUrl(locale, 'imprint')} />
</Layout>

<script>
    // CvSection is static TSX (not hydrated), so the download button's
    // handler is wired here — mirrors the old .astro's native onclick.
    document.querySelector('.cv-download')?.addEventListener('click', () => window.print());
</script>
