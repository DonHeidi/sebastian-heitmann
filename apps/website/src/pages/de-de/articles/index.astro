---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Navigation } from '../../../components/navigation';
import ThemeToggle from '@/components/theme-toggle.astro';
import { ArticleCard } from '../../../components/article-card';
import { Footer } from '../../../components/footer';
import { getStrings, getHreflangAlternates } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/utils';
import { blog, itemList } from '@sh/structured-data';
import { absoluteUrl } from '../../../i18n/utils';

const locale = (Astro.currentLocale ?? 'de-de') as Locale;
const s = getStrings(locale);
const alternates = getHreflangAlternates('/articles');

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const enArticles = allArticles.filter(({ id }) => !id.startsWith('de-de/'));
const deArticles = allArticles.filter(({ id }) => id.startsWith('de-de/'));
const deSlugs = new Set(deArticles.map(({ id }) => id.replace('de-de/', '')));
const articles = [
  ...deArticles,
  ...enArticles.filter(({ id }) => !deSlugs.has(id)),
];

const sorted = articles.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const structuredNodes = [
  // The Blog node is the parent every BlogPosting points at via isPartOf.
  blog({ site: 'dev', locale, name: 'Artikel', url: absoluteUrl('/de-de/articles') }),
  // Finding 2: an entry with no German translation is a fallback page that
  // self-canonicalizes to the English URL (see de-de/articles/[slug].astro
  // and astro.config.mjs's sitemap filter, which excludes those very URLs
  // with the comment "a sitemap should only list canonical URLs"). Listing
  // the /de-de/articles/<slug>/ URL here for those entries would re-advertise
  // exactly the non-canonical URLs the sitemap was changed to suppress, so
  // each entry must point at its own canonical URL, not always the German one.
  itemList(sorted.map((article) => {
    const slug = article.id.replace(/^de-de\//, '');
    const isTranslated = article.id.startsWith('de-de/');
    return {
      url: isTranslated ? absoluteUrl(`/de-de/articles/${slug}`) : absoluteUrl(`/articles/${slug}`),
      name: article.data.title,
    };
  })),
];

const editorialArticles = sorted.filter((article) => article.data.type !== 'service-description');
const serviceDescriptions = sorted.filter((article) => article.data.type === 'service-description');

const editorialImageSrcs = await Promise.all(
  editorialArticles.map(async (article) =>
    article.data.headerImage
      ? (await getImage({ src: article.data.headerImage, width: 600, height: 340, format: 'webp' })).src
      : undefined
  )
);
const serviceImageSrcs = await Promise.all(
  serviceDescriptions.map(async (article) =>
    article.data.headerImage
      ? (await getImage({ src: article.data.headerImage, width: 600, height: 340, format: 'webp' })).src
      : undefined
  )
);
---

<Layout
  locale={locale}
  title={`Artikel — Sebastian Heitmann`}
  description={s.meta.description}
  alternates={alternates}
  pageType="CollectionPage"
  breadcrumbLabel="Artikel"
  nodes={structuredNodes}
>
  <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
    <ThemeToggle labels={s.nav.themeToggle} />
  </Navigation>

  <main class="articles-page">
    <header class="articles-page__header">
      <h1 class="articles-page__title">Artikel</h1>
      <div class="articles-page__rule"></div>
    </header>

    <section class="articles-page__section" aria-label="Artikel">
      <div class="articles-page__grid">
        {editorialArticles.map((article, i) => {
          const slug = article.id.startsWith('de-de/')
            ? article.id.replace('de-de/', '')
            : article.id;
          return (
            <div
              class="reveal"
              style={`transition-delay: ${Math.min(i * 80, 400)}ms`}
            >
              <ArticleCard
                title={article.data.title}
                abstract={article.data.abstract}
                categoryLabel={s.categories[article.data.category]}
                tags={article.data.tags}
                publishedAt={article.data.publishedAt}
                slug={slug}
                imageSrc={editorialImageSrcs[i]}
                locale={locale}
              />
            </div>
          );
        })}
      </div>
    </section>

    {serviceDescriptions.length > 0 && (
      <section class="articles-page__section" aria-labelledby="service-descriptions-heading">
        <h2 class="articles-page__section-title" id="service-descriptions-heading">Leistungen</h2>
        <div class="articles-page__grid">
          {serviceDescriptions.map((article, i) => {
            const slug = article.id.startsWith('de-de/')
              ? article.id.replace('de-de/', '')
              : article.id;
            return (
              <div
                class="reveal"
                style={`transition-delay: ${Math.min(i * 80, 400)}ms`}
              >
                <ArticleCard
                  title={article.data.title}
                  abstract={article.data.abstract}
                  categoryLabel={s.categories[article.data.category]}
                  tags={article.data.tags}
                  publishedAt={article.data.publishedAt}
                  slug={slug}
                  imageSrc={serviceImageSrcs[i]}
                  locale={locale}
                />
              </div>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <Footer footer={s.footer} privacyHref={getRelativeLocaleUrl(locale, 'privacy')} imprintHref={getRelativeLocaleUrl(locale, 'imprint')} />
</Layout>

<style>
  .articles-page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 160px 80px 120px;
  }

  .articles-page__header {
    margin-bottom: 64px;
  }

  .articles-page__title {
    font-family: var(--v8-font-display);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.0;
    color: var(--v8-text);
    margin-bottom: 48px;
  }

  .articles-page__rule {
    width: 48px;
    height: 2px;
    background-color: var(--v8-accent);
  }

  .articles-page__section {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .articles-page__section + .articles-page__section {
    margin-top: 72px;
    padding-top: 72px;
    border-top: 1px solid var(--v8-border);
  }

  .articles-page__section-title {
    font-family: var(--v8-font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v8-text-muted);
  }

  .articles-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .articles-page {
      padding: 120px 48px 80px;
    }
  }

  @media (max-width: 768px) {
    .articles-page {
      padding: 100px 24px 60px;
    }

    .articles-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
