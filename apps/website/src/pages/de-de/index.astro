---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { Navigation } from '../../components/navigation';
import { ThemeToggle } from '../../components/theme-toggle';
import { Hero } from '../../components/hero';
import picture from '../../assets/fb.jpg';
import { LogoSection, type LogoAsset } from '../../components/logo-section';
import poolPositionLogo from '../../assets/logos/pool-position.png';
import jvmLogo from '../../assets/logos/jvm.svg';
import synvertLogo from '../../assets/logos/synvert.png';
import grannySmithLogo from '../../assets/logos/granny-smith.jpg';
import offisLogo from '../../assets/logos/offis.svg';
import { CapabilitiesSection } from '../../components/capabilities-section';
import { SituationsSection } from '../../components/situations-section';
import ProofSection from '../../components/proof-section.astro';
import FeaturedArticlesSection from '../../components/featured-articles-section.astro';
import { ContactSection } from '../../components/contact-section';
import { ContactForm } from '../../components/contact-form';
import Footer from '../../components/footer.astro';
import { getStrings, getHreflangAlternates } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const locale = Astro.currentLocale as Locale;
const s = getStrings(locale);
const alternates = getHreflangAlternates();
const mailEndpoint = import.meta.env.PUBLIC_MAIL_ENDPOINT || '';

const heroPhoto = await getImage({ src: picture, width: 160, height: 160 });

// Per-logo config to compensate for varying whitespace baked into source images:
// height = render height (taller = more internal whitespace to compensate for),
// spacing = vertical margin (px) in the mobile stacked layout — less for logos
// with built-in whitespace, more for tightly cropped logos.
const logoConfig: Array<{ name: string; src: ImageMetadata; height: number; spacing: number; noInvert?: boolean }> = [
    { name: 'Pool Position GmbH', src: poolPositionLogo, height: 70, spacing: 0 },
    { name: 'Jung von Matt', src: jvmLogo, height: 24, spacing: 14 },
    { name: 'synvert', src: synvertLogo, height: 31, spacing: 10 },
    { name: 'Granny & Smith', src: grannySmithLogo, height: 53, spacing: 0, noInvert: true },
    { name: 'OFFIS', src: offisLogo, height: 48, spacing: 4 },
];
const logoAssets: LogoAsset[] = await Promise.all(
    logoConfig.map(async ({ name, src, height, spacing, noInvert }) => {
        const image = await getImage({ src, height });
        return { name, src: image.src, width: Number(image.attributes.width), height, spacing, noInvert };
    })
);

const allPublished = await getCollection('articles', ({ data }) => !data.draft);
const dePublished = allPublished.filter(({ id }) => id.startsWith('de-de/'));
const enPublished = allPublished.filter(({ id }) => !id.startsWith('de-de/'));
const deSlugs = new Set(dePublished.map(({ id }) => id.replace('de-de/', '')));
const totalArticleCount = [...dePublished, ...enPublished.filter(({ id }) => !deSlugs.has(id))].length;

const allFeatured = allPublished.filter(({ data }) => data.displayFrontpage);
const deFeatured = allFeatured.filter(({ id }) => id.startsWith('de-de/'));
const enFeatured = allFeatured.filter(({ id }) => !id.startsWith('de-de/'));
const deFeaturedSlugs = new Set(deFeatured.map(({ id }) => id.replace('de-de/', '')));
const featured = [
    ...deFeatured,
    ...enFeatured.filter(({ id }) => !deFeaturedSlugs.has(id)),
]
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .slice(0, 3)
    .map((entry) => ({
        entry,
        slug: entry.id.startsWith('de-de/') ? entry.id.replace('de-de/', '') : entry.id,
        categoryLabel: s.categories[entry.data.category],
    }));
---
<Layout locale={locale} title={s.meta.title} description={s.meta.description} alternates={alternates} showBackdrop={true}>
    <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
        <ThemeToggle client:load labels={s.nav.themeToggle} />
    </Navigation>
    <main>
        <Hero hero={s.hero} photoSrc={heroPhoto.src} photoWidth={Number(heroPhoto.attributes.width)} photoHeight={Number(heroPhoto.attributes.height)} />
        <LogoSection logos={s.logos} logoAssets={logoAssets} />
        <CapabilitiesSection capabilities={s.capabilities} />
        <SituationsSection situations={s.situations} />
        <ProofSection proof={s.proof} webDevLink={{ label: 'Webentwicklung für lokale Unternehmen', href: '/de-de/web-entwicklung' }} tpmLink={{ label: 'Technisches Projektmanagement', href: '/de-de/technisches-projektmanagement' }} />
        <FeaturedArticlesSection articles={featured} strings={s.featuredArticles} locale={locale} totalCount={totalArticleCount} />
        <ContactSection contact={s.contact}>
            <ContactForm client:visible strings={s.contact} endpoint={mailEndpoint} />
        </ContactSection>
    </main>
    <Footer footer={s.footer} />
</Layout>
