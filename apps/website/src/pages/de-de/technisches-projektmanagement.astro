---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Navigation } from '../../components/navigation';
import { ThemeToggle } from '../../components/theme-toggle';
import { TechnicalProjectManagementContent } from '../../components/technical-project-management-content';
import { ContactSection } from '../../components/contact-section';
import { ContactForm } from '../../components/contact-form';
import { Footer } from '../../components/footer';
import { getStrings, getHreflangAlternates } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const locale = Astro.currentLocale as Locale;
const s = getStrings(locale);
const mailEndpoint = import.meta.env.PUBLIC_MAIL_ENDPOINT || '';
const contact = { ...s.contact, headline: s.technicalProjectManagement.contact.headline, intro: s.technicalProjectManagement.contact.intro };

const alternates = getHreflangAlternates('/technical-project-management', '/de-de/technisches-projektmanagement');
---
<Layout
    locale={locale}
    title={s.technicalProjectManagement.meta.title}
    description={s.technicalProjectManagement.meta.description}
    alternates={alternates}
>
    <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
        <ThemeToggle client:load labels={s.nav.themeToggle} />
    </Navigation>
    <main>
        <TechnicalProjectManagementContent content={s.technicalProjectManagement} />
        <ContactSection contact={contact}>
            <ContactForm client:visible strings={contact} endpoint={mailEndpoint} />
        </ContactSection>
    </main>
    <Footer footer={s.footer} privacyHref={getRelativeLocaleUrl(locale, 'privacy')} imprintHref={getRelativeLocaleUrl(locale, 'imprint')} />
</Layout>
