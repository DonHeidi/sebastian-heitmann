---
import Layout from '../layouts/Layout.astro';
import { Navigation } from '../components/navigation';
import { ThemeToggle } from '../components/theme-toggle';
import WebProjectsContent from '../components/web-projects-content.astro';
import { ContactSection } from '../components/contact-section';
import { ContactForm } from '../components/contact-form';
import Footer from '../components/footer.astro';
import { getStrings } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

const locale = Astro.currentLocale as Locale;
const s = getStrings(locale);
const mailEndpoint = import.meta.env.PUBLIC_MAIL_ENDPOINT || '';
const contact = { ...s.contact, headline: s.webProjects.contact.headline, intro: s.webProjects.contact.intro };

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.sebastian-heitmann.dev').replace(/\/$/, '');
const alternates = [
    { hreflang: 'en', href: `${siteUrl}/web-development` },
    { hreflang: 'de-DE', href: `${siteUrl}/de-de/web-entwicklung` },
    { hreflang: 'x-default', href: `${siteUrl}/web-development` },
];
---
<Layout
    locale={locale}
    title={s.webProjects.meta.title}
    description={s.webProjects.meta.description}
    alternates={alternates}
>
    <Navigation nav={s.nav} languagePicker={s.languagePicker} locale={locale} currentPath={Astro.url.pathname}>
        <ThemeToggle client:load labels={s.nav.themeToggle} />
    </Navigation>
    <main>
        <WebProjectsContent content={s.webProjects} locale={locale} />
        <ContactSection contact={contact}>
            <ContactForm client:visible strings={contact} endpoint={mailEndpoint} />
        </ContactSection>
    </main>
    <Footer footer={s.footer} />
</Layout>
